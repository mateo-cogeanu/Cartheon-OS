#!/bin/sh
set -eu

dpkg --add-architecture i386
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --install-recommends \
    winehq-stable dxvk dxvk-wine64 dxvk-wine32

wine_version=$(wine --version | sed -n 's/^wine-\([0-9][0-9]*\).*/\1/p')
if [ -z "$wine_version" ] || [ "$wine_version" -lt 11 ]; then
    echo "Cartheon OS requires Wine 11 or newer; found: $(wine --version)" >&2
    exit 1
fi
