[Unit]
Description=Cartheon OS appliance session
After=systemd-user-sessions.service systemd-logind.service
Conflicts=display-manager.service getty@tty1.service
Before=graphical.target

[Service]
User=player
Group=player
PAMName=login
Environment=HOME=/home/player
WorkingDirectory=/home/player
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/xinit /usr/bin/cartheon-session -- :0 vt1 -keeptty -nolisten tcp
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
