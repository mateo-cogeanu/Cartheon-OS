#!/usr/bin/python3
"""Graphical network gate shown before the live installer starts."""

from __future__ import annotations

import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402


CSS = b"""
window { background: #0c1020; color: #f5f7ff; }
.heading { font-size: 28px; font-weight: 800; }
.explanation { color: #bac1d9; font-size: 15px; }
.status { color: #a9b4d8; }
.error { color: #ff7999; }
.network-row { padding: 10px 12px; }
.signal { color: #8e9cff; }
"""


def nmcli(*arguments: str, timeout: int = 40) -> subprocess.CompletedProcess[str]:
    """Run NetworkManager's CLI without ever invoking a shell."""
    return subprocess.run(
        ["nmcli", *arguments],
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def connectivity() -> str:
    result = nmcli("-t", "-f", "CONNECTIVITY", "general", timeout=10)
    if result.returncode != 0:
        return "unknown"
    return result.stdout.strip().lower()


def internet_is_ready(force_check: bool = False) -> bool:
    if force_check:
        result = nmcli("networking", "connectivity", "check", timeout=20)
        return result.returncode == 0 and result.stdout.strip().lower() == "full"
    return connectivity() == "full"


def split_escaped_fields(line: str) -> list[str]:
    """Split nmcli's escaped colon format while retaining literal colons."""
    fields: list[str] = []
    field: list[str] = []
    escaped = False
    for character in line:
        if escaped:
            field.append(character)
            escaped = False
        elif character == "\\":
            escaped = True
        elif character == ":":
            fields.append("".join(field))
            field = []
        else:
            field.append(character)
    if escaped:
        field.append("\\")
    fields.append("".join(field))
    return fields


def scan_networks() -> list[tuple[str, int, str]]:
    nmcli("radio", "wifi", "on", timeout=10)
    result = nmcli(
        "--terse",
        "--escape",
        "yes",
        "--fields",
        "SSID,SIGNAL,SECURITY",
        "device",
        "wifi",
        "list",
        "--rescan",
        "yes",
        timeout=45,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or "NetworkManager could not scan for Wi-Fi."
        raise RuntimeError(message)

    strongest: dict[str, tuple[int, str]] = {}
    for line in result.stdout.splitlines():
        fields = split_escaped_fields(line)
        if len(fields) != 3 or not fields[0]:
            continue
        ssid, signal_text, security = fields
        try:
            signal = int(signal_text)
        except ValueError:
            signal = 0
        previous = strongest.get(ssid)
        if previous is None or signal > previous[0]:
            strongest[ssid] = (signal, security)
    return sorted(
        ((ssid, signal, security) for ssid, (signal, security) in strongest.items()),
        key=lambda network: (-network[1], network[0].casefold()),
    )


class NetworkWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application) -> None:
        super().__init__(application=application, title="Cartheon Internet Setup")
        self.fullscreen()
        self.set_default_size(1280, 720)
        self.result = 1
        self.network_security: dict[str, str] = {}

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_margin_top(24)
        content.set_margin_bottom(24)
        content.set_margin_start(28)
        content.set_margin_end(28)
        self.set_child(content)

        heading = Gtk.Label(label="Connect to the internet")
        heading.add_css_class("heading")
        heading.set_halign(Gtk.Align.START)
        content.append(heading)

        explanation = Gtk.Label(
            label=(
                "Cartheon setup needs an internet connection to download required "
                "packages. Wired connections are detected automatically."
            )
        )
        explanation.add_css_class("explanation")
        explanation.set_halign(Gtk.Align.START)
        explanation.set_wrap(True)
        explanation.set_max_width_chars(70)
        content.append(explanation)

        self.network_list = Gtk.ListBox()
        self.network_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.network_list.connect("row-selected", self._network_selected)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(self.network_list)
        content.append(scroll)

        ssid_label = Gtk.Label(label="Wi-Fi network name")
        ssid_label.set_halign(Gtk.Align.START)
        content.append(ssid_label)
        self.ssid = Gtk.Entry()
        self.ssid.set_placeholder_text("Select a network above or type a hidden network")
        content.append(self.ssid)

        password_label = Gtk.Label(label="Wi-Fi password")
        password_label.set_halign(Gtk.Align.START)
        content.append(password_label)
        self.password = Gtk.PasswordEntry()
        self.password.set_show_peek_icon(True)
        self.password.set_placeholder_text("Leave empty for an open network")
        self.password.connect("activate", self._connect_clicked)
        content.append(self.password)

        status_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.spinner = Gtk.Spinner()
        status_line.append(self.spinner)
        self.status = Gtk.Label(label="Scanning for Wi-Fi networks…")
        self.status.add_css_class("status")
        self.status.set_wrap(True)
        self.status.set_hexpand(True)
        self.status.set_halign(Gtk.Align.START)
        status_line.append(self.status)
        content.append(status_line)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        buttons.set_halign(Gtk.Align.END)
        self.cancel_button = Gtk.Button(label="Cancel setup")
        self.cancel_button.connect("clicked", self._cancel)
        buttons.append(self.cancel_button)
        self.refresh_button = Gtk.Button(label="Refresh")
        self.refresh_button.connect("clicked", self._refresh_clicked)
        buttons.append(self.refresh_button)
        self.connect_button = Gtk.Button(label="Connect and install")
        self.connect_button.add_css_class("suggested-action")
        self.connect_button.connect("clicked", self._connect_clicked)
        buttons.append(self.connect_button)
        content.append(buttons)

        self.connect("close-request", self._close_requested)
        self._refresh()

    def _set_busy(self, busy: bool) -> None:
        self.refresh_button.set_sensitive(not busy)
        self.connect_button.set_sensitive(not busy)
        self.cancel_button.set_sensitive(not busy)
        self.ssid.set_sensitive(not busy)
        self.password.set_sensitive(not busy)
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()

    def _show_status(self, message: str, error: bool = False) -> None:
        self.status.set_label(message)
        if error:
            self.status.add_css_class("error")
        else:
            self.status.remove_css_class("error")

    def _refresh_clicked(self, _button: Gtk.Button) -> None:
        self._refresh()

    def _refresh(self) -> None:
        self._set_busy(True)
        self._show_status("Checking the connection and scanning for Wi-Fi networks…")
        threading.Thread(target=self._scan_worker, daemon=True).start()

    def _scan_worker(self) -> None:
        try:
            if internet_is_ready(force_check=True):
                GLib.idle_add(self._online)
                return
            networks = scan_networks()
            GLib.idle_add(self._populate_networks, networks)
        except (OSError, subprocess.TimeoutExpired, RuntimeError) as exc:
            GLib.idle_add(self._scan_failed, str(exc))

    def _clear_networks(self) -> None:
        while child := self.network_list.get_first_child():
            self.network_list.remove(child)

    def _populate_networks(self, networks: list[tuple[str, int, str]]) -> bool:
        self._clear_networks()
        self.network_security = {}
        for ssid, signal, security in networks:
            self.network_security[ssid] = security
            row = Gtk.ListBoxRow()
            row.network_ssid = ssid
            row.add_css_class("network-row")
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            name = Gtk.Label(label=ssid)
            name.set_hexpand(True)
            name.set_halign(Gtk.Align.START)
            line.append(name)
            details = Gtk.Label(
                label=f"{signal}%  {'Open' if security in ('', '--') else security}"
            )
            details.add_css_class("signal")
            line.append(details)
            row.set_child(line)
            self.network_list.append(row)

        self._set_busy(False)
        if networks:
            self._show_status("Select your Wi-Fi network, enter its password, then connect.")
        else:
            self._show_status(
                "No visible Wi-Fi networks were found. You can type a hidden network "
                "name, connect an Ethernet cable, or refresh.",
                error=True,
            )
        return False

    def _scan_failed(self, message: str) -> bool:
        self._clear_networks()
        self._set_busy(False)
        self._show_status(
            f"Wi-Fi scan failed: {message}. Connect Ethernet or press Refresh to retry.",
            error=True,
        )
        return False

    def _network_selected(
        self, _list_box: Gtk.ListBox, row: Gtk.ListBoxRow | None
    ) -> None:
        if row is not None:
            self.ssid.set_text(row.network_ssid)
            self.password.grab_focus()

    def _connect_clicked(self, _widget: Gtk.Widget) -> None:
        network = self.ssid.get_text().strip()
        password = self.password.get_text()
        security = self.network_security.get(network, "")
        if not network:
            self._show_status("Select or enter a Wi-Fi network name.", error=True)
            return
        if security not in ("", "--") and not password:
            self._show_status(f"{network} requires a Wi-Fi password.", error=True)
            return

        self._set_busy(True)
        self._show_status(f"Connecting to {network} and checking internet access…")
        threading.Thread(
            target=self._connect_worker,
            args=(network, password, network not in self.network_security),
            daemon=True,
        ).start()

    def _connect_worker(self, network: str, password: str, hidden: bool) -> None:
        arguments = ["--wait", "35", "device", "wifi", "connect", network]
        if password:
            arguments.extend(("password", password))
        if hidden:
            arguments.extend(("hidden", "yes"))
        try:
            result = nmcli(*arguments, timeout=45)
            if result.returncode != 0:
                message = result.stderr.strip() or result.stdout.strip()
                raise RuntimeError(message or "NetworkManager rejected the connection.")
            for _attempt in range(5):
                if internet_is_ready(force_check=True):
                    GLib.idle_add(self._online)
                    return
                time.sleep(1)
            raise RuntimeError(
                "Wi-Fi connected, but internet access could not be verified."
            )
        except (OSError, subprocess.TimeoutExpired, RuntimeError) as exc:
            GLib.idle_add(self._connect_failed, str(exc))

    def _connect_failed(self, message: str) -> bool:
        self._set_busy(False)
        self._show_status(f"Connection failed: {message}", error=True)
        self.password.select_region(0, -1)
        self.password.grab_focus()
        return False

    def _online(self) -> bool:
        self.result = 0
        self._show_status("Internet connection verified. Starting Cartheon setup…")
        self.spinner.stop()
        GLib.timeout_add(500, self._finish)
        return False

    def _finish(self) -> bool:
        self.get_application().quit()
        return False

    def _cancel(self, _button: Gtk.Button) -> None:
        self.get_application().quit()

    def _close_requested(self, _window: Gtk.Window) -> bool:
        self.get_application().quit()
        return False


class NetworkApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(
            application_id="org.cartheon.NetworkSetup",
            flags=Gio.ApplicationFlags.NON_UNIQUE,
        )
        self.window: NetworkWindow | None = None
        self.result = 1

    def do_activate(self) -> None:
        if self.window is None:
            self.window = NetworkWindow(self)
        self.window.present()

    def do_shutdown(self) -> None:
        if self.window is not None:
            self.result = self.window.result
        Gtk.Application.do_shutdown(self)


def main() -> int:
    if internet_is_ready():
        return 0
    application = NetworkApplication()
    application.run(sys.argv)
    return application.result


if __name__ == "__main__":
    raise SystemExit(main())
