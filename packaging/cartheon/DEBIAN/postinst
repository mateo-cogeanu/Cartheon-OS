#!/bin/sh
set -e

if ! getent passwd player >/dev/null; then
    useradd --create-home --uid 1000 --shell /bin/bash --comment "Cartheon Player" player
fi

# live-config skips user setup when the account already exists. Give the
# pre-created appliance account Debian Live's standard "live" password hash so
# PAM permits LightDM's configured passwordless autologin.
usermod --password '8Ab05sVQ4LLps' player

for group in audio video input render plugdev; do
    if getent group "$group" >/dev/null; then
        usermod --append --groups "$group" player
    fi
done

install -d -o player -g player /home/player/.local/share/cartheon

# Cartheon is an appliance session, so start X directly instead of depending
# on a greeter's autologin behavior. LightDM stays installed for compatibility
# with Calamares and can still be enabled manually for diagnostics.
systemctl disable lightdm.service >/dev/null 2>&1 || true
systemctl enable cartheon-session.service >/dev/null 2>&1 || true

#DEBHELPER#
