#!/bin/sh
set -e

if ! getent passwd player >/dev/null; then
    useradd --create-home --uid 1000 --shell /bin/bash --comment "Cartheon Player" player
fi

# live-config skips user setup when the account already exists. Give the
# pre-created appliance account Debian Live's standard "live" password hash so
# PAM permits LightDM's configured passwordless autologin.
usermod --password '8Ab05sVQ4LLps' player

# live-config may create the account before this package while leaving its home
# owned by root. LightDM needs the home to create X authority/session files.
chown player:player /home/player

for group in audio video input render plugdev; do
    if getent group "$group" >/dev/null; then
        usermod --append --groups "$group" player
    fi
done

install -d -o player -g player \
    /home/player/.local \
    /home/player/.local/share \
    /home/player/.local/share/cartheon

# Let LightDM own Xorg, VT permissions, and the unprivileged player session.
systemctl disable cartheon-session.service >/dev/null 2>&1 || true
rm -f /etc/systemd/system/graphical.target.wants/cartheon-session.service
systemctl enable lightdm.service >/dev/null 2>&1 || true

#DEBHELPER#
